# Environments / secrets
.venv/
.env
.env.local
.env*.local

# Vercel
.vercel/

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# NOTE: data/eucri.db and site/ outputs ARE committed by design (audit trail).
# SQLite's WAL sidecars are not: they belong to an open connection, not to the record.
data/*.db-wal
data/*.db-shm
# Held only while a sweep runs; one left behind by a killed runner must not be committed.
data/intraday/.lock

# Design handoff working folder (mockups + prototyping runtime, not part of the build)
Compute Index Branding/

# Rendered brand-asset previews. The source HTML in tools/ is the artefact worth
# keeping; these are throwaway renders used to check a logo before shipping it.
tools/out/
